# V1 SQLite runtime configuration
DENTAL_APP_MODE=clean
DENTAL_DB_PATH=data/dental.db
DENTAL_UPLOAD_ROOT=uploads
DENTAL_EXPORT_ROOT=exports
DENTAL_BACKUP_ROOT=backups
DENTAL_AUTO_BACKUP_ENABLED=true

# Phase 11 hosted staging: use DENTAL_SERVER_ENV=staging with HTTPS services.
# In hosting, inject server values through platform secrets and start with npm run start:hosted.
# Production-mode Node processes refuse an implicit local environment.
# CORS_ALLOWED_ORIGINS must contain exact HTTPS frontend origins, comma-separated.
# HOST and PORT may be provided by the host; hosted default HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3002
CORS_ALLOWED_ORIGINS=http://localhost:5173

# V2 PostgreSQL foundation configuration
# Server-only values. Do not expose these to the client.
DENTAL_SERVER_ENV=local
DATABASE_URL=postgresql://app_user:replace_me@127.0.0.1:5432/dental_v2_local
TEST_DATABASE_URL=postgresql://app_user:replace_me@127.0.0.1:5432/dental_v2_test
DATABASE_SSL_MODE=disable
# Optional trusted PEM root CA for verified hosted PostgreSQL TLS.
# Store the CA certificate outside the repository; do not disable verification.
# DATABASE_SSL_CA_FILE=/absolute/path/to/staging-supabase-ca.crt
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000
PGSTATEMENT_TIMEOUT_MS=15000
PGAPP_NAME=dental-record-system-v2-foundation
ALLOW_PRODUCTION_DB_COMMANDS=false

# V2 authentication foundation (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=replace_with_server_only_secret_key
AUTH_JWT_AUDIENCE=authenticated
AUTH_REQUEST_TIMEOUT_MS=5000
STAFF_PROVISIONING_REQUEST_TIMEOUT_MS=8000
STAFF_INVITE_REDIRECT_URL=http://localhost:5173/activate-account

# V2 private attachment storage (server only)
SUPABASE_ATTACHMENT_BUCKET=dental-attachments-dev
ATTACHMENT_STORAGE_REQUEST_TIMEOUT_MS=10000
ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=120

# V2 browser authentication (public browser-safe values only)
# Hosted frontend builds must set VITE_APP_ENV=staging and a matching HTTPS VITE_API_BASE_URL.
# Hosted builds expose only auth/account/activation/recovery routes while clinical routes await V2 cutover.
VITE_APP_ENV=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
VITE_API_BASE_URL=http://127.0.0.1:3002/api
