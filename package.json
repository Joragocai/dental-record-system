{
  "name": "electronic-dental-record-system",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:postgres": "node server/scripts/devPostgresLocal.js",
    "dev:client": "npm run dev --workspace client",
    "demo:prepare": "node server/scripts/demoPrepare.js",
    "dev:demo": "node server/scripts/devDemo.js",
    "demo:reset": "node server/scripts/demoReset.js",
    "demo:cleanup": "node server/scripts/demoCleanup.js",
    "demo": "npm run dev:demo",
    "backup:create": "node server/scripts/createManualBackup.js",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "body-parser": "^1.20.9",
    "qs": "^6.16.1",
    "follow-redirects": "1.16.1",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "^2.1.7"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
