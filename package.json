{
  "name": "electronic-dental-record-system",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "demo:prepare": "node server/scripts/demoPrepare.js",
    "dev:demo": "node server/scripts/devDemo.js",
    "demo:reset": "node server/scripts/demoReset.js",
    "demo:cleanup": "node server/scripts/demoCleanup.js",
    "demo": "npm run dev:demo",
    "backup:create": "node server/scripts/createManualBackup.js",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:migrate:status": "npm run db:migrate:status --workspace server",
    "test:postgres:foundation": "npm run test:postgres:foundation --workspace server",
    "test:postgres:batch-a": "npm run test:postgres:batch-a --workspace server",
    "test:postgres:batch-b": "npm run test:postgres:batch-b --workspace server",
    "test:postgres:batch-c": "npm run test:postgres:batch-c --workspace server",
    "test:postgres:access": "npm run test:postgres:access --workspace server",
    "test:authorization": "npm run test:authorization --workspace server",
    "test:staff": "npm run test:staff --workspace server",
    "test:provisioning": "npm run test:provisioning --workspace server",
    "test:bootstrap": "npm run test:bootstrap --workspace server",
    "bootstrap:branch": "npm run bootstrap:branch --workspace server",
    "bootstrap:owner": "npm run bootstrap:owner --workspace server",
    "bootstrap:owner:resend": "npm run bootstrap:owner:resend --workspace server",
    "bootstrap:owner:status": "npm run bootstrap:owner:status --workspace server",
    "test:audit": "npm run test:audit --workspace server",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc --project client/tsconfig.json",
    "typecheck:server": "tsc --project server/tsconfig.json",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.0.1",
    "typescript": "^7.0.2"
  }
}
