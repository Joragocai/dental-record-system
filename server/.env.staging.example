# COPY to server/.env.staging (gitignored). Never commit or share the filled file.
# Use the NEW staging project's connection string, not development/production.
DENTAL_SERVER_ENV=staging
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_STAGING_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL_MODE=require
# If certificate validation fails, download the STAGING project's CA certificate
# from Supabase Dashboard > Project Settings > Database > SSL Configuration.
# Store it outside the repository and use an ABSOLUTE WSL file path below.
# DATABASE_SSL_CA_FILE=/home/YOUR_LINUX_USER/.config/dental-staging/supabase-ca.crt
ALLOW_PRODUCTION_DB_COMMANDS=false

# No server-only secret key is needed for the read-only migration-status step.
# Do not put project secrets into chat or Git.
# When an approved staging service is configured, its secret environment
# variables are managed separately from this local read-only status file.
